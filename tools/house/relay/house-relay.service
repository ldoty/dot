# The house relay (relay.mjs), installed by scripts/deploy-relay.sh into the relay container.
# The token and key files are readable only by the relay user; see tools/house/README.md.
[Unit]
Description=House relay: Home Assistant to house.dot-y.co
After=network-online.target
Wants=network-online.target

[Service]
User=relay
# network-online.target doesn't wait in this container: wait for a default route (up to a minute)
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do ip route | grep -q "^default" && exit 0; sleep 1; done; exit 0'
TimeoutStopSec=15
WorkingDirectory=/opt/house-relay
ExecStart=/usr/local/bin/node /opt/house-relay/relay.mjs
Environment=HA_URL=ws://192.168.0.165/api/websocket
Environment=HA_TOKEN_FILE=/etc/house-relay/ha-token
Environment=HOUSE_KEY_FILE=/etc/house-relay/house-key
EnvironmentFile=/etc/house-relay/env
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
# /var/lib/house-relay: the automations, kept across restarts (the one place it may write)
StateDirectory=house-relay
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
